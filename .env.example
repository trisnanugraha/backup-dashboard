# Salin ke .env lalu isi. Jangan commit file .env.

# --- MySQL (environment existing) ---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=backup_monitoring
MYSQL_USER=backup_app
MYSQL_PASSWORD=

# --- API & dashboard ---
API_PORT=3000
WEB_PORT=8080
# Origin dashboard React (kosongkan kalau dashboard di-serve dari domain yang sama / lewat reverse proxy)
API_CORS_ORIGIN=

# --- Laporan PDF (tahap 7) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NEXTCLOUD_BASE_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_ROOT_FOLDER=rekap-backup

TIMEZONE=Asia/Jakarta
